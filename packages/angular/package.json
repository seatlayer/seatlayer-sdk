{
  "name": "@seatlayer/angular",
  "version": "0.77.1",
  "description": "SeatLayer's official Angular seating chart and seat map SDK \u2014 live availability, seat selection, temporary holds, and a typed TypeScript API for ticketing apps.",
  "license": "MIT",
  "author": {
    "name": "SeatLayer",
    "url": "https://seatlayer.io/"
  },
  "homepage": "https://seatlayer.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seatlayer/seatlayer-sdk.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/seatlayer/seatlayer-sdk/issues"
  },
  "sideEffects": false,
  "keywords": [
    "seat map",
    "seating chart",
    "seat-map",
    "seating-chart",
    "seat-picker",
    "seat-selection",
    "seat-reservation",
    "reserved-seating",
    "seat-booking",
    "event-ticketing",
    "ticketing",
    "live-inventory",
    "seating",
    "seatlayer",
    "angular",
    "typescript"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node ./check-entry-points.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@seatlayer/core": "0.77.1",
    "@seatlayer/js": "0.77.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "ng-packagr": "^20.0.0",
    "rxjs": "^7.8.1",
    "typescript": "^5.9.0",
    "zone.js": "^0.15.0"
  },
  "module": "./dist/fesm2022/seatlayer-angular.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/seatlayer-angular.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ]
}
