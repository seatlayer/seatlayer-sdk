{
  "name": "@seatlayer/vue",
  "version": "0.59.0",
  "description": "Vue 3 SeatLayer SDK — one native SeatingChart wrapper plus raw JS SeatPickerWidget and iframe helper.",
  "license": "MIT",
  "author": {
    "name": "SeatLayer",
    "url": "https://seatlayer.io/"
  },
  "homepage": "https://seatlayer.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seatlayer/seatlayer-sdk.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/seatlayer/seatlayer-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "seating",
    "seat-map",
    "seating-chart",
    "seat-picker",
    "seatlayer",
    "vue",
    "vue3",
    "ticketing"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@seatlayer/core": "0.59.0",
    "@seatlayer/js": "0.59.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vue": "^3.5.13"
  }
}
