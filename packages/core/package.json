{
  "name": "@seatlayer/core",
  "version": "0.47.1",
  "description": "Framework-agnostic seat-rendering engine (Konva) shared by the SeatLayer SDKs.",
  "license": "MIT",
  "homepage": "https://docs.seatlayer.io/buyer-sdk/install/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seatlayer/seatlayer-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/seatlayer/seatlayer-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//deep-subpaths": "`./view/panoramaDelivery` and `./view3d/crossfade/panorama` are two engine modules the buyer widget imports by their path inside the mirrored src/ tree instead of through a barrel. The app's vendored widget resolves the same two relatively (../../view/panoramaDelivery, ../../view3d/crossfade/panorama), and scripts/sync-widget.mjs rewrites '@seatlayer/core/<path>' into '../../<path>' \u2014 which lines up character for character only because dist/ mirrors src/, and src/ mirrors the app's src/. Renaming either subpath silently breaks that rewrite. NOTE: keys inside `exports` must be subpaths or conditions, so this note lives out here; a '//' key in there makes Node and TypeScript reject the whole map, which shows up as 'Cannot find module @seatlayer/core/view3d'.",
  "typesVersions": {
    "*": {
      "view3d": [
        "./dist/view3d/index.d.ts"
      ],
      "view/panoramaDelivery": [
        "./dist/view/panoramaDelivery.d.ts"
      ],
      "view3d/crossfade/panorama": [
        "./dist/view3d/crossfade/panorama.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./view3d": {
      "import": {
        "types": "./dist/view3d/index.d.ts",
        "default": "./dist/view3d/index.js"
      },
      "require": {
        "types": "./dist/view3d/index.d.cts",
        "default": "./dist/view3d/index.cjs"
      }
    },
    "./view/panoramaDelivery": {
      "import": {
        "types": "./dist/view/panoramaDelivery.d.ts",
        "default": "./dist/view/panoramaDelivery.js"
      },
      "require": {
        "types": "./dist/view/panoramaDelivery.d.cts",
        "default": "./dist/view/panoramaDelivery.cjs"
      }
    },
    "./view3d/crossfade/panorama": {
      "import": {
        "types": "./dist/view3d/crossfade/panorama.d.ts",
        "default": "./dist/view3d/crossfade/panorama.js"
      },
      "require": {
        "types": "./dist/view3d/crossfade/panorama.d.cts",
        "default": "./dist/view3d/crossfade/panorama.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "seating",
    "seat-map",
    "seatlayer",
    "konva",
    "canvas",
    "seating-chart",
    "reserved-seating"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "konva": "^10.3.0",
    "ogl": "^1.0.11",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
